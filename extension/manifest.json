{
  "manifest_version": 3,
  "name": "Onay",
  "version": "0.0.0",
  "description": "Hands signing requests to the Onay app for verification before your wallet sees them.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Onay",
    "default_popup": "popup.html"
  }
}
