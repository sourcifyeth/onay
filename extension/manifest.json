{
  "manifest_version": 3,
  "name": "Onay",
  "version": "0.0.0",
  "description": "Sends each signing request to the local Onay app for a second, independent check before your wallet signs.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Onay",
    "default_popup": "popup.html"
  }
}
