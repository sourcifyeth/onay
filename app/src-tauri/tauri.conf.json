{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onay",
  "version": "0.0.0",
  "identifier": "dev.sourcify.onay",
  "build": {
    "beforeDevCommand": "pnpm relay && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onay",
        "width": 960,
        "height": 720,
        "userAgent": "Onay/0.0.0 (+https://github.com/sourcifyeth/onay)"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*"
    }
  }
}
