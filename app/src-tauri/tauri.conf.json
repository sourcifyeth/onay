{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onay",
  "version": "0.0.0",
  "identifier": "dev.sourcify.onay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onay",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
